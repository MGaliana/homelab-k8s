#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

# Key-only access; no passwords anywhere.
ssh_pwauth: false
disable_root: true
users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

timezone: UTC
# Packages and OS config are Ansible's job; cloud-init only makes the node reachable.
package_update: false
